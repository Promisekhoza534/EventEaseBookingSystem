@model EventEase.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="card card-custom p-4">
    <h2 class="page-title">Create Event</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Upload Event Image</label>
                    <input asp-for="ImageFile" type="file" class="form-control" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label">Event Name</label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label">Event Date and Time</label>
                    <input asp-for="EventDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventTypeId" class="form-label">Event Type</label>
                    <select asp-for="EventTypeId" class="form-select" asp-items="ViewBag.EventTypeId">
                        <option value="">-- Select Event Type --</option>
                    </select>
                    <span asp-validation-for="EventTypeId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VenueId" class="form-label">Venue</label>
                    <select asp-for="VenueId" class="form-select" asp-items="ViewBag.VenueId">
                        <option value="">-- Select Venue --</option>
                    </select>
                    <span asp-validation-for="VenueId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark btn-custom">Create Event</button>
                <a asp-action="Index" class="btn btn-secondary btn-custom">Back to List</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
