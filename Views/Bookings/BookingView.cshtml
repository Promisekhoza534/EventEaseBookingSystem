@model IEnumerable<EventEase.Models.BookingDetailsViewModel>

@{
    ViewData["Title"] = "Booking Details View";
}

<div class="card card-custom p-4">
    <h2 class="page-title">Booking Details View</h2>
    <hr />

    <form asp-action="BookingView" method="get" class="mb-4">
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <input type="text"
                       name="searchString"
                       value="@ViewData["SearchString"]"
                       class="form-control"
                       placeholder="Search by Booking ID or Event Name..." />
            </div>

            <div class="col-md-3">
                <select name="eventTypeId"
                        class="form-select"
                        asp-items="ViewBag.EventTypeId">
                    <option value="">All Event Types</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">Start Date</label>
                <input type="date"
                       name="startDate"
                       value="@ViewData["StartDate"]"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">End Date</label>
                <input type="date"
                       name="endDate"
                       value="@ViewData["EndDate"]"
                       class="form-control" />
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-3">
                <select name="availability" class="form-select">
                    <option value="">All Venue Availability</option>

                    @if (ViewData["Availability"]?.ToString() == "True")
                    {
                        <option value="true" selected>Available</option>
                    }
                    else
                    {
                        <option value="true">Available</option>
                    }

                    @if (ViewData["Availability"]?.ToString() == "False")
                    {
                        <option value="false" selected>Unavailable</option>
                    }
                    else
                    {
                        <option value="false">Unavailable</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="BookingView" class="btn btn-secondary">Clear</a>
                <a asp-action="Index" class="btn btn-info">Back to Bookings</a>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Booking Date</th>
                    <th>Customer Name</th>
                    <th>Customer Contact</th>
                    <th>Event Name</th>
                    <th>Event Type</th>
                    <th>Event Date</th>
                    <th>Event Description</th>
                    <th>Venue Name</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Availability</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BookingId</td>
                            <td>@item.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.CustomerName</td>
                            <td>@item.CustomerContact</td>
                            <td>@item.EventName</td>
                            <td>@item.EventTypeName</td>
                            <td>@item.EventDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.EventDescription</td>
                            <td>@item.VenueName</td>
                            <td>@item.Location</td>
                            <td>@item.Capacity</td>
                            <td>
                                @if (item.Availability)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unavailable</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12" class="text-center text-muted">
                            No bookings found for the selected filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
